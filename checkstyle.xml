<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- Keep source lines within a readable length. -->
    <module name="LineLength">
        <property name="max" value="125"/>
        <property name="ignorePattern" value="^package.*|^import.*"/>
    </module>

    <!-- Prevent tabs from being used for indentation. -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">

        <!-- Keep imports explicit instead of using wildcard imports. -->
        <module name="AvoidStarImport"/>

        <!-- Require blank lines between declarations for readability. -->
        <module name="EmptyLineSeparator"/>

        <!-- Allow descriptive test names using underscores. -->
        <module name="MethodName">
            <property name="format"
                      value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
        </module>

        <!-- Enforce standard naming for types. -->
        <module name="TypeName"/>

        <!-- Keep field names in camelCase. -->
        <module name="MemberName"/>

        <!-- Keep parameter names in camelCase. -->
        <module name="ParameterName"/>

        <!-- Keep local variable names in camelCase. -->
        <module name="LocalVariableName"/>

        <!-- Keep constant names in UPPER_SNAKE_CASE. -->
        <module name="ConstantName"/>

        <!-- Keep Java modifiers in a consistent order. -->
        <module name="ModifierOrder"/>

        <!-- Avoid unnecessary Java modifiers. -->
        <module name="RedundantModifier"/>

        <!-- Require braces around control statements. -->
        <module name="NeedBraces"/>

        <!-- Keep whitespace after tokens consistent. -->
        <module name="WhitespaceAfter"/>

        <!-- Keep whitespace around tokens consistent. -->
        <module name="WhitespaceAround"/>

        <!-- Prevent unused imports. -->
        <module name="UnusedImports"/>

        <!-- Keep imports grouped and alphabetically ordered. -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STATIC###STANDARD_JAVA_PACKAGE###SPECIAL_IMPORTS###THIRD_PARTY_PACKAGE"/>
            <property name="specialImportsRegExp" value="^org\."/>
            <property name="thirdPartyPackageRegExp" value="^com\."/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
            <property name="severity" value="error"/>
        </module>

        <!-- Keep class members in a consistent order. -->
        <module name="DeclarationOrder"/>

        <!-- Prevent empty code blocks unless explicitly allowed. -->
        <module name="EmptyBlock"/>

        <!-- Keep variable declarations explicit and readable. -->
        <module name="MultipleVariableDeclarations"/>

        <!-- Keep one top-level class per source file. -->
        <module name="OneTopLevelClass"/>

    </module>

</module>